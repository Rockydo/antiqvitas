# Generated by tools/m10_situation_panels.py --write; do not edit directly.
# Uses the installed common situation-panel contract with ANTIQVITAS content.
situation_panel = {
	blockoverride "situation_panel_image" {
		background = {
			texture = "gfx/interface/illustrations/situation/antq_m10_immensum_bellum.dds"
		}
		using = scene_fade_vertical_up
	}

	blockoverride "situation_panel_main_content" {
		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 10 }
			spacing = 6
			text_single = {
				layoutpolicy_horizontal = expanding
				align = center
				text = "[SituationView.GetActiveSituation.GetName]"
				default_format = "#header_titles"
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				max_width = 420
				autoresize = yes
				text = "antq_m10_fourth_constantine_civil_wars_tooltip"
			}
		}

		situation_card_expandable = {
			blockoverride "header_button_onclick" {
				onclick = "[LateralView.Vars.Toggle( 'requirements_toggled' )]"
			}
			blockoverride "header_text" { text = "END_REQUIREMENTS" }
			blockoverride "header_icon" { texture = "gfx/interface/icons/disasters/end_requirements_green.dds" }
			blockoverride "bottom_content" {
				TooltipRequirementsList = {
					textcontext = "[SituationView.GetActiveSituation.GetSituation.GetEndConditions]"
				}
			}
			blockoverride "bottom_content_onclick" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_yes" {
				visible = "[LateralView.Vars.Exists( 'requirements_toggled' )]"
			}
			blockoverride "icon_replace_visible_not" {
				visible = "[Not(LateralView.Vars.Exists( 'requirements_toggled' ))]"
			}
		}

		situation_card_expandable = {
			blockoverride "header_text" { text = "antq_m10_fourth_constantine_civil_wars_tooltip" }
			blockoverride "header_icon" { texture = "[SituationView.GetActiveSituation.GetIcon]" }
			blockoverride "bottom_content" {
				text_multi = {
					margin = { 15 0 }
					layoutpolicy_horizontal = expanding
					max_width = 420
					autoresize = yes
					text = "antq_m10_fourth_constantine_civil_wars_tooltip"
				}
			}
		}

		situation_card_expandable = {
			blockoverride "header_text" { text = "antq_m10_fourth_constantine_civil_wars_progress" }
			blockoverride "header_icon" { texture = "gfx/interface/icons/situations/tension.dds" }
			blockoverride "bottom_content" {
				text_single = {
					layoutpolicy_horizontal = expanding
					align = center
					raw_text = "[FixedPointToInt(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('antq_m10_fourth_constantine_civil_wars_resolution_progress').GetValue)] / 100"
				}
			}
		}
	}

	blockoverride "situation_variable_progress_bar_visible" { visible = yes }
	blockoverride "disaster_progressbar" {
		hbox = {
			using = situation_disaster_progressbar_with_thresholds
			blockoverride "progressbar_with_thresholds_size" { size = { 340 10 } }
			blockoverride "progress_bar_value_low" {
				value = "[Min_float(FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('antq_m10_fourth_constantine_civil_wars_resolution_progress').GetValue), '(float)100')]"
			}
			blockoverride "progress_bar_value_mid" {
				value = "[Max_float(Subtract_float(Min_float(FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('antq_m10_fourth_constantine_civil_wars_resolution_progress').GetValue), '(float)66'), '(float)33'), '(float)0')]"
			}
			blockoverride "progress_bar_value_high" {
				value = "[Max_float(Subtract_float(FixedPointToFloat(SituationView.GetActiveSituation.GetSituation.MakeScope.GetVariable('antq_m10_fourth_constantine_civil_wars_resolution_progress').GetValue), '(float)66'), '(float)0')]"
			}
		}
	}
}
